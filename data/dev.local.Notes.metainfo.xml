<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.local.Notes</id>
  <name>Notes</name>
  <summary>A native notes app with an integrated WebDAV sync server</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <developer id="io.github.kalotrapezis">
    <name>kalotrapezis</name>
  </developer>
  <description>
    <p>
      Notes is a GTK desktop application for writing and organising Markdown
      notes in folders and tags.
    </p>
    <p>
      Its integrated WebDAV server syncs compatible mobile clients without a
      separate server. It also supports Keep and Obsidian imports, backup and
      restore, coloured cards, search, and bulk editing.
    </p>
  </description>
  <launchable type="desktop-id">dev.local.Notes.desktop</launchable>
  <url type="homepage">https://github.com/kalotrapezis/Notes</url>
  <url type="bugtracker">https://github.com/kalotrapezis/Notes/issues</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/kalotrapezis/Notes/main/docs/screenshots/app-overview.png</image>
      <caption>Organise notes in folders and edit Markdown in one window</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/kalotrapezis/Notes/main/docs/screenshots/app-search.png</image>
      <caption>Find notes instantly with full-text search</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/kalotrapezis/Notes/main/docs/screenshots/backup-restore.png</image>
      <caption>Create and restore portable backups</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.0.1" date="2026-07-22">
      <description>
        <p>First public release.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
