[Icon Theme]
Name=Notes bundled
Comment=Icons shipped with the app so it looks the same on every desktop
Directories=scalable/actions,512x512/apps,256x256/apps,128x128/apps,64x64/apps,48x48/apps
Hidden=true

[scalable/actions]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Actions

[512x512/apps]
Size=512
Type=Fixed
Context=Applications

[256x256/apps]
Size=256
Type=Fixed
Context=Applications

[128x128/apps]
Size=128
Type=Fixed
Context=Applications

[64x64/apps]
Size=64
Type=Fixed
Context=Applications

[48x48/apps]
Size=48
Type=Fixed
Context=Applications
